# ==============================================================================
# ONETIMEPRINT — SECURE ONE-TIME PDF PRINTING PLATFORM
# Production Environment Variables Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Get this from your Neon Console (https://console.neon.tech).
# Ensure "sslmode=require" or "pooled" connection string is used.
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# Generate a 32+ character random secret using: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-cryptographically-secure-random-32-char-string"

# Canonical URL of your deployment (Vercel production URL or custom domain)
NEXTAUTH_URL="https://your-domain.com"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Initial Administrator Credentials (used during automatic schema bootstrap)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_DEFAULT_PASSWORD="YourStrongAdminPassword123!"

# ------------------------------------------------------------------------------
# 3. FILE STORAGE (Cloudflare R2)
# ------------------------------------------------------------------------------
# Cloudflare Account ID (Found in Cloudflare Dashboard URL or Overview)
R2_ACCOUNT_ID="your_cloudflare_account_id"

# Cloudflare R2 API Token credentials with Object Read & Write permissions
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"

# Name of your private Cloudflare R2 bucket (e.g., onetimeprint-vault)
R2_BUCKET_NAME="onetimeprint-vault"

# S3-compatible R2 endpoint (Optional if R2_ACCOUNT_ID is set)
# Format: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT="https://your_cloudflare_account_id.r2.cloudflarestorage.com"

# ------------------------------------------------------------------------------
# 4. PLATFORM LIMITS & POLICIES
# ------------------------------------------------------------------------------
# Maximum upload size in bytes (26214400 bytes = 25 MB)
MAX_FILE_SIZE=26214400

# Default expiration duration in hours (24 hours)
TOKEN_EXPIRY_DEFAULT_HOURS=24
